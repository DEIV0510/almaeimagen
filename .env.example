# Copia este archivo como .env y rellena los valores reales.

# PostgreSQL en la nube (Neon, Vercel Postgres, Supabase…).
# Usa la conexión DIRECTA (sin "-pooler" / "pgbouncer=true") para db:push y db:seed.
DATABASE_URL="postgresql://usuario:password@host/basededatos?sslmode=require"

# Clave secreta para firmar las sesiones (genera una cadena larga y aleatoria).
JWT_SECRET="cambia-esto-por-una-clave-larga-y-unica"
